from nupy import *

def put_tile(tile_idx, x, y):
    # Draw a raw 8x8 font tile by index (0-255).
    # Variable count is tight (max 11): reuse px as the on/off scratch.
    if tile_idx < 0:
        return
    if tile_idx > 255:
        return

    row = 0
    while row < 8:
        font_addr = tile_idx * 8 + row
        row_bits = read("SYSROM", font_addr)

        mask = 128
        col = 0
        while col < 8:
            px = row_bits & mask
            if px != 0:
                px = x + col
                py = y + row
                setPixel(px, py, 1)
            mask = mask >> 1
            col = col + 1
        row = row + 1

def main():
    setStackPointer(0x7F00)
    setActivePalette(0, 0)
    setActivePalette(1, 4095)
    while 1:
        cls()
        mx = read("VOLATILE", 0x8013)
        my = read("VOLATILE", 0x8014)

        put_tile(210, mx, my)
        frameBlit()

main()